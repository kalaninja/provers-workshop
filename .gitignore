# Rust build output
/target/

# Creusot: track proof sessions (verif/**/proof.json) for `just creusot replay`; ignore the
# generated Coma (regenerated from source) and the prover result cache.
/verif/**/*.coma
/.why3find/

# Aeneas: track the Lean proof project (lakefile, generated Lean, hand proofs, lake-manifest) for
# `just aeneas replay`; ignore Lake's build output and its package cache (symlinked to the image's
# baked Aeneas + mathlib build at run time).
/verif/**/.lake/

# hax: the inline Rust proof is the source artifact. Lean extraction + Lake's generated manifest are
# regenerated and checked from scratch by `just hax verify`, so neither is committed.
/verif/ticketing_hax/extraction/
/verif/ticketing_hax/lake-manifest.json

# Local tool caches (populated by run-tooling.sh volume mounts)
/.cache/

# Codama codegen harness dependencies
/clients/node_modules/

# Editor metadata
/.idea/
/.vscode/
/.zed/

# OS-level noise
.DS_Store

# Local logs
*.log

# Separate git repo for talks and articles (versioned independently)
/materials/
