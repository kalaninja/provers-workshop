#!/usr/bin/env bash

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

zero='0000000000000000000000000000000000000000'

changed_files=""
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${local_ref:-}" ]] && continue
  if [[ "${local_sha}" == "${zero}" ]]; then
    continue
  fi
  if [[ "${remote_sha}" == "${zero}" ]]; then
    base="$(git merge-base "${local_sha}" origin/main 2>/dev/null || true)"
    if [[ -z "${base}" ]]; then
      range="${local_sha}"
    else
      range="${base}..${local_sha}"
    fi
  else
    range="${remote_sha}..${local_sha}"
  fi
  changed_files+="$(git diff --name-only "${range}" 2>/dev/null || true)"$'\n'
done

trimmed="$(printf '%s' "${changed_files}" | tr -d '[:space:]')"
if [[ -z "${trimmed}" ]]; then
  exit 0
fi

has() {
  printf '%s' "${changed_files}" | grep -qE "$1"
}

run() {
  printf '\n→ %s\n' "$*"
  "$@"
}

rust_changed=false
creusot_changed=false
kani_changed=false
verus_changed=false
flux_changed=false
aeneas_changed=false
hax_changed=false
verifast_changed=false
shared_tooling_changed=false

has '^(crates/|clients/|idl/|Cargo\.toml|Cargo\.lock|rustfmt\.toml|clippy\.toml|mise/config(\.[a-z]+)?\.toml)' && rust_changed=true
has '^(crates/ticketing/|mise/config\.creusot\.toml|just/creusot\.just|why3find\.json|verif/|docker/creusot\.Dockerfile$)' && creusot_changed=true
has '^(crates/ticketing/kani/|mise/config\.kani\.toml|just/kani\.just|docker/kani\.Dockerfile$)' && kani_changed=true
has '^(crates/ticketing/verus/|mise/config\.verus\.toml|just/verus\.just|docker/verus\.Dockerfile$)' && verus_changed=true
has '^(crates/ticketing/flux/|mise/config\.flux\.toml|just/flux\.just|docker/flux\.Dockerfile$)' && flux_changed=true
has '^(crates/ticketing/aeneas/|mise/config\.aeneas\.toml|just/aeneas\.just|scripts/aeneas/|verif/ticketing_aeneas/|docker/aeneas\.Dockerfile$)' && aeneas_changed=true
has '^(crates/ticketing/hax/|mise/config\.hax\.toml|just/hax\.just|scripts/hax/|verif/ticketing_hax/|docker/hax\.Dockerfile$)' && hax_changed=true
has '^(crates/ticketing/verifast/|mise/config\.verifast\.toml|just/verifast\.just|docker/verifast\.Dockerfile$)' && verifast_changed=true
has '^(Dockerfile|just/common\.just|just/tooling\.just)$' && shared_tooling_changed=true

if $shared_tooling_changed; then
  rust_changed=true
  creusot_changed=true
  kani_changed=true
  verus_changed=true
  flux_changed=true
  aeneas_changed=true
  hax_changed=true
  verifast_changed=true
fi

if $rust_changed; then
  run just rust fmt-check
  run just rust clippy
  run just rust test
  run just solana test-it
  run just rust machete
fi

if $creusot_changed; then
  run just creusot replay
fi

if $kani_changed; then
  run just kani verify
fi

if $verus_changed; then
  run just verus fmt-check
  run just verus verify
fi

if $flux_changed; then
  run just flux verify
fi

if $aeneas_changed; then
  run just aeneas replay
fi

if $hax_changed; then
  run just hax verify
fi

if $verifast_changed; then
  run just verifast verify
fi

printf '\npre-push: all checks passed\n'
